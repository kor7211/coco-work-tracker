<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Recorder.Views.CreateRecordPage">
    <VerticalStackLayout>
        <ActivityIndicator x:Name="LoadingIndicator"
                   IsRunning="False"
                   IsVisible="False"
                   Color="{StaticResource IndicatorColor}" />
        
        <Entry x:Name="TitleEnEntry"
               Placeholder="Title En" />
        <Entry x:Name="TitleJaEntry"
               Placeholder="Title Ja" />
        <Entry x:Name="CommentEnEntry"
               Placeholder="Comment En" />
        <Entry x:Name="CommentJaEntry"
               Placeholder="Comment ja" />
        <Picker x:Name="TypePicker" />
        <Entry x:Name="DurationEntry"
               Placeholder="Duration (min)"
               Keyboard="Numeric" />
        <Entry x:Name="BreakEntry"
               Placeholder="Break (min)"
               Keyboard="Numeric" />
        <DatePicker x:Name="StartedDatePicker"
                    MinimumDate="01/01/2000"
                    MaximumDate="12/31/2099" />
        <TimePicker x:Name="StartedTimePicker" />
        <Picker x:Name="TimezonePicker" />
        <!--Image-->
        <Button x:Name="AddImageButton"
                Text="Add Image"
                Style="{StaticResource ButtonSmall}"
                Clicked="OnAddImageClicked" />
        <CollectionView x:Name="ImageContainer">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Text="{Binding Title}"
                               Placeholder="Enter image name"
                               VerticalOptions="Center" />

                        <Button Grid.Column="1"
                                Text="Remove"
                                Style="{StaticResource ButtonSmall}"
                                Clicked="OnRemoveImageClicked" />   
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button x:Name="CreateButton"
                Text="Create"
                Style="{StaticResource ButtonLarge}"
                Clicked="OnCreateClicked" />

        <Label x:Name="ErrorLabel"
               Text=""
               Style="{StaticResource Error}" />

        <Label x:Name="SuccessLabel"
               Text=""
               Style="{StaticResource Success}" />
    </VerticalStackLayout>
</ContentPage>