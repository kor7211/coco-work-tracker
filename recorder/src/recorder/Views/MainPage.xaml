<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Recorder.Views.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Button Text="Histories" 
                    Style="{StaticResource ButtonLarge}"
                    Clicked="OnListRecordsClicked"/>

            <Button Text="Work Types"
                    Style="{StaticResource ButtonMedium}" 
                    Clicked="OnListTypesClicked"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
