<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Recorder.Controls.RecordCard">

    <Border x:Name="OutlineBorder"
            WidthRequest="500"
            StrokeThickness="5"
            Padding="5, 3"
            StrokeShape="{RoundRectangle CornerRadius='5'}"
            BackgroundColor="{StaticResource BackgroundShadeColor}">
        <VerticalStackLayout
            Padding="10, 5">
            <Label x:Name="TypeLabel"
                   Text="Type" 
                   Style="{StaticResource MainConetent}"
                   HorizontalOptions="Center"/>
            <Grid ColumnDefinitions="*, auto, auto"
                  HorizontalOptions="Fill">
                <Label x:Name="TitleLabel"
                       Style="{StaticResource Title}" />
                <Label Text="En/Ja" 
                       Grid.Column="1"
                       VerticalOptions="Center"/>
                <Switch x:Name="LanguageSwitch"
                        Grid.Column="2"
                        IsToggled="False"
                        OffColor="{StaticResource SecondaryColor}"
                        OnColor="{StaticResource SecondaryColor}"
                        Toggled="OnLanguageToggled" />
            </Grid>
            <Label x:Name="CommentLabel"
                   Style="{StaticResource MainConetent}"/>
            
            <Label x:Name="DurationLabel"
                   Text="0(min)" />

            <Label x:Name="BreakLabel"
                   Text="0(min)" />

            <Label x:Name="StartedLabel"
                   Text="01/01/2000" />

            <Label x:Name="UploadedLabel"
                   Text="01/01/2000" />

            <Label x:Name="TimezoneLabel"
                   Text="Japan/Tokyo" />

            <Grid x:Name="ImageGrid"
                  IsVisible="Hidden"
                  ColumnDefinitions="auto,*, auto" >
                <ImageButton x:Name="BackImageButton"
                             Source="arrow_back.png"
                             Clicked="OnBackImageClicked" 
                             VerticalOptions="Center"/>

                <Image x:Name="ImageContainer"
                       Grid.Column="1" 
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       MaximumHeightRequest="500"
                       Aspect="AspectFit"
                       />

                <ImageButton x:Name="ForwardImageButton"
                             Grid.Column="2"
                             Source="arrow_forward.png"
                             Clicked="OnForwardImageClicked" 
                             VerticalOptions="Center"/>
            </Grid>
                  
        </VerticalStackLayout>
    </Border>
</ContentView>
