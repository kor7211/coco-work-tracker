<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Recorder.Controls.RecordCard">

    <Border x:Name="OutlineBorder">
        <VerticalStackLayout
            Padding="10, 5">
            <Label x:Name="TypeLabel"
                   Text="Type" 
                   VerticalOptions="Center"/>
            <Grid ColumnDefinitions="*, auto, auto"
                  VerticalOptions="Fill">
                <Label x:Name="TitleLabel"
                       Style="{StaticResource SubHeadline}" />
                <Label Text="En/Ja" 
                       Grid.Column="1"/>
                <Switch x:Name="LanguageSwitch"
                        Grid.Column="2"
                        IsToggled="True"
                        Toggled="OnLanguageToggled" />
            </Grid>
            <Label x:Name="CommentLabel" />
            
            <Label x:Name="DurationLabel"
                   Text="0(min)" />

            <Label x:Name="BreakLabel"
                   Text="0(min)" />

            <Label x:Name="StartedLabel"
                   Text="01/01/2000" />

            <Label x:Name="UploadedLabel"
                   Text="01/01/2000" />

            <Label x:Name="TimezoneLabel"
                   Text="Japan/Tokyo" />

            <Grid x:Name="ImageGrid"
                  IsVisible="Hidden"
                  ColumnDefinitions="auto,*, auto" >
                <ImageButton x:Name="BackImageButton"
                             Source="arrow_back.png"
                             Clicked="OnBackImageClicked" />

                <Image x:Name="ImageContainer"
                       Grid.Column="1" />

                <ImageButton x:Name="ForwardImageButton"
                             Grid.Column="2"
                             Source="arrow_forward.png"
                             Clicked="OnForwardImageClicked" />
            </Grid>
                  
        </VerticalStackLayout>
    </Border>
</ContentView>
