<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Label">
        <Setter Property="TextColor"
                Value="{StaticResource TextOnBackgroundColor}" />
        <Setter Property="FontFamily"
                Value="NunitoSans" />
        <Setter Property="FontSize"
                Value="Medium" />
    </Style>

    <Style TargetType="Label" x:Key="Error">
        <Setter Property="TextColor"
            Value="{StaticResource TextError}" />
        <Setter Property="FontFamily"
            Value="NunitoSans" />
        <Setter Property="FontSize"
            Value="Default" />
    </Style>

    <Style TargetType="Label" x:Key="Success">
        <Setter Property="TextColor"
            Value="{StaticResource TextSuccess}" />
        <Setter Property="FontFamily"
            Value="NunitoSans" />
        <Setter Property="FontSize"
            Value="Default" />
    </Style>

    <Style TargetType="Label" x:Key="Headline">
        <Setter Property="TextColor"
        Value="{StaticResource TextHeadline}" />
        <Setter Property="FontFamily"
        Value="AntonRegular" />
        <Setter Property="FontSize"
        Value="Header" />
    </Style>

</ResourceDictionary>